{
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff"
    },
    "[quarto]": {
        "editor.defaultFormatter": "quarto.quarto",
        "editor.indentSize": "tabSize",
        "editor.tabSize": 2
    },
    "[r]": {
        "editor.defaultFormatter": "Posit.air-vscode",
        "editor.indentSize": "tabSize",
        "editor.tabSize": 2
    },
    "console.showNotebookConsoleActions": true,
    "console.showNotebookConsoles": true,
    "dataExplorer.enablePreview": true,
    "dataExplorer.summaryCollapsed": true,
    "diffEditor.codeLens": true,
    "diffEditor.experimental.showMoves": true,
    "diffEditor.experimental.useTrueInlineView": true,
    "diffEditor.hideUnchangedRegions.enabled": true,
    "diffEditor.ignoreTrimWhitespace": true,
    "diffEditor.renderSideBySide": true,
    "editor.accessibilitySupport": "off",
    "editor.autoIndentOnPaste": true,
    "editor.copyWithSyntaxHighlighting": false,
    "editor.experimental.preferTreeSitter.css": true,
    "editor.experimental.preferTreeSitter.ini": true,
    "editor.experimental.preferTreeSitter.regex": true,
    "editor.experimental.preferTreeSitter.typescript": true,
    "editor.experimental.treeSitterTelemetry": true,
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.guides.bracketPairs": "active",
    "editor.inlineSuggest.syntaxHighlightingEnabled": true,
    "editor.minimap.enabled": true,
    "editor.renderFinalNewline": "dimmed",
    "editor.renderWhitespace": "all",
    "editor.rulers": [
        80
    ],
    "editor.scrollBeyondLastLine": false,
    "editor.smoothScrolling": true,
    "editor.tabCompletion": "on",
    "editor.unicodeHighlight.invisibleCharacters": true,
    "editor.wordWrap": "on",
    "editor.wrapOnEscapedLineFeeds": true,
    "editor.wrappingStrategy": "advanced",
    "files.associations": {
        "renv.lock": "json"
    },
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "git.autofetch": true,
    "git.blame.editorDecoration.enabled": true,
    "git.blame.ignoreWhitespace": true,
    "git.branchRandomName.dictionary": [
        "numbers",
        "colors"
    ],
    "git.branchRandomName.enable": true,
    "git.confirmSync": false,
    "git.enableCommitSigning": true,
    "git.enableSmartCommit": true,
    "notebook.diff.ignoreMetadata": true,
    "notebook.diff.ignoreOutputs": true,
    "notebook.formatOnCellExecution": true,
    "notebook.formatOnSave.enabled": true,
    "notebook.inlineValues": "auto",
    "notebook.insertFinalNewline": true,
    "notebook.lineNumbers": "on",
    "notebook.showFoldingControls": "always",
    "notebook.stickyScroll.enabled": true,
    "notebook.workingDirectory": "${workspaceFolder}",
    "packages.r.installer": "pak",
    "positron.assistant.notebook.ghostCellSuggestions.enabled": true,
    "positron.notebook.enabled": true,
    "positron.notebook.experimental": true,
    "positron.r.defaultRepositories": "posit-ppm",
    "positron.r.interpreters.pixiDiscovery": true,
    "positron.r.workspaceSymbols.includeCommentSections": true,
    "python.interpreters.exclude": [
        "/usr/bin/python3",
        "/opt/homebrew/bin/python3"
    ],
    "python.terminal.shellIntegration.enabled": true,
    "quarto.inlineOutput.enabled": true,
    "rewrap.autoWrap.enabled": true,
    "rewrap.reformat": true,
    "rewrap.wrappingColumn": 80,
    "ruff.format.preview": true,
    "terminal.external.osxExec": "Ghostty.app",
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.integrated.smoothScrolling": true,
    "terminal.integrated.suggest.enabled": true,
    "terminal.integrated.suggest.providers": {
        "lsp": true
    },
    "ty.completions.completeFunctionParentheses": true,
    "window.autoDetectColorScheme": true,
    "window.commandCenter": true,
    "workbench.activityBar.location": "top",
    "workbench.colorTheme": "Dark 2026",
    "workbench.editor.highlightModifiedTabs": true,
    "workbench.editor.pinnedTabsOnSeparateRow": true,
    "workbench.keybindings.rstudioKeybindings": true,
    "workbench.preferredDarkColorTheme": "Dark 2026",
    "workbench.preferredLightColorTheme": "Light 2026",
    "workbench.settings.alwaysShowAdvancedSettings": true,
    "python.pixiToolPath": "/opt/homebrew/bin/pixi",
    "window.nativeTabs": true,
    "python.installModulesInTerminal": true,
    "githubPullRequests.createOnPublishBranch": "never"
}
